POSTGRES_DB=investment_intelligence
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-for-non-local-use
DATABASE_URL=postgresql+psycopg://app:change-me-for-non-local-use@postgres:5432/investment_intelligence
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
MARKET_DATA_PROVIDER=twelve_data
MARKET_DATA_API_KEY=your-twelve-data-key
MARKET_DATA_BASE_URL=https://api.twelvedata.com
MARKET_DATA_TIMEOUT_SECONDS=10
MARKET_DATA_MAX_RETRIES=2
MARKET_DATA_CACHE_ENABLED=true
MARKET_DATA_SYMBOL_CACHE_TTL_SECONDS=3600
MARKET_DATA_CANDLE_CACHE_TTL_SECONDS=300
MARKET_DATA_QUOTE_CACHE_TTL_SECONDS=15
ASSET_CLASSIFICATION_CACHE_TTL_SECONDS=86400
ASSET_PROFILE_CACHE_TTL_SECONDS=86400
ASSET_FUNDAMENTALS_CACHE_TTL_SECONDS=21600
MARKET_DATA_DEFAULT_CANDLE_LIMIT=100
MARKET_DATA_MAX_CANDLE_LIMIT=500
INTELLIGENCE_POLL_INTERVAL_SECONDS=30
INTELLIGENCE_LIVE_THRESHOLD_SECONDS=60
INTELLIGENCE_STALE_THRESHOLD_SECONDS=900
INTELLIGENCE_CANDLE_LOOKBACK=260
